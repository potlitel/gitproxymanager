<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\Icons\app-icon.ico</ApplicationIcon>
    <AssemblyTitle>Git Proxy Manager</AssemblyTitle>
    <Description>Gestor de proxy para Git</Description>
    <Company>GitProxyManager</Company>
    <Product>Git Proxy Manager</Product>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="MahApps.Metro" Version="2.4.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Icons\app-icon.ico" />
    <EmbeddedResource Include="Resources\Icons\app-icon-active.ico" />
    <Resource Include="Resources\Icons\app-icon.ico" />
    <Resource Include="Resources\Icons\app-icon-active.ico" />
  </ItemGroup>

</Project>