<mahApps:MetroWindow x:Class="GitProxyManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mahApps="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
        xmlns:local="clr-namespace:GitProxyManager"
        xmlns:viewModel="clr-namespace:GitProxyManager.ViewModels"
        Title="Git Proxy Manager"
        Height="660" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowTitleBar="True"
        ShowDialogsOverTitleBar="False"
        Background="#1E1E2E"
        Foreground="#CDD6F4">

    <mahApps:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <local:BoolToHorizontalAlignmentConverter x:Key="BoolToHorizontalAlignmentConverter"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
    </mahApps:MetroWindow.Resources>

    <Grid>
        <Grid.DataContext>
            <viewModel:MainViewModel/>
        </Grid.DataContext>
        <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Git Proxy Manager"
                   FontSize="22" FontWeight="Bold"
                   Foreground="#89B4FA" Margin="0,0,0,16"/>

        <!-- Master Toggle -->
        <Border x:Name="MasterBorder" Grid.Row="1" Background="#45475A" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Border.RenderTransform>
                <ScaleTransform x:Name="MasterScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔗"
                           FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>

                <TextBlock Grid.Column="1" Text="Habilitar ambos"
                           VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                           Foreground="#CDD6F4"/>

                <ToggleButton x:Name="MasterToggleProxy" Grid.Column="2"
                              IsChecked="{Binding MasterToggle}"
                              MinWidth="60" MinHeight="30"
                              VerticalAlignment="Center">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="toggleBorder"
                                    CornerRadius="15" Padding="3"
                                    Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolToBrushConverter}}"
                                    Cursor="Hand">
                                <Border x:Name="toggleKnob"
                                        Width="24" Height="24"
                                        CornerRadius="12"
                                        Background="#CDD6F4"
                                        Margin="2"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="toggleKnob" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="toggleKnob" Property="HorizontalAlignment" Value="Left"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
            </Grid>
        </Border>

        <!-- System Proxy Toggle -->
        <Border x:Name="SystemBorder" Grid.Row="2" Background="#313244" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
            <Border.RenderTransform>
                <ScaleTransform x:Name="SystemScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🖥️"
                           FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Proxy del sistema"
                               FontSize="14" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                    <TextBlock Text="Windows (navegadores, etc.)"
                               FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,0"/>
                </StackPanel>

                <ToggleButton x:Name="SystemToggleProxy" Grid.Column="2"
                              IsChecked="{Binding IsSystemEnabled}"
                              IsEnabled="{Binding CanToggle}"
                              Margin="12,0"
                              MinWidth="46" MinHeight="24"
                              VerticalAlignment="Center">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="toggleBorder"
                                    CornerRadius="12" Padding="3"
                                    Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolToBrushConverter}}"
                                    Cursor="Hand">
                                <Border x:Name="toggleKnob"
                                        Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="#CDD6F4"
                                        Margin="2"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="toggleKnob" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="toggleKnob" Property="HorizontalAlignment" Value="Left"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Ellipse Grid.Column="3" Width="8" Height="8"
                         VerticalAlignment="Center" Margin="10,0,0,0"
                         Fill="{Binding SystemStatusColor}"/>
            </Grid>
        </Border>

        <!-- Git Proxy Toggle -->
        <Border x:Name="GitBorder" Grid.Row="3" Background="#313244" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
            <Border.RenderTransform>
                <ScaleTransform x:Name="GitScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🔧"
                           FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Proxy de Git"
                               FontSize="14" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                    <TextBlock Text="Solo operaciones git"
                               FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,0"/>
                </StackPanel>

                <ToggleButton x:Name="GitToggleProxy" Grid.Column="2"
                              IsChecked="{Binding IsGitEnabled}"
                              IsEnabled="{Binding CanToggle}"
                              Margin="12,0"
                              MinWidth="46" MinHeight="24"
                              VerticalAlignment="Center">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="toggleBorder"
                                    CornerRadius="12" Padding="3"
                                    Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsChecked, Converter={StaticResource BoolToBrushConverter}}"
                                    Cursor="Hand">
                                <Border x:Name="toggleKnob"
                                        Width="18" Height="18"
                                        CornerRadius="9"
                                        Background="#CDD6F4"
                                        Margin="2"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="toggleKnob" Property="HorizontalAlignment" Value="Right"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="False">
                                    <Setter TargetName="toggleKnob" Property="HorizontalAlignment" Value="Left"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Ellipse Grid.Column="3" Width="8" Height="8"
                         VerticalAlignment="Center" Margin="10,0,0,0"
                         Fill="{Binding GitStatusColor}"/>
            </Grid>
        </Border>

        <!-- Proxy Host + Port -->
        <Border Grid.Row="4" Background="#313244" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Proxy:"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="#CDD6F4" Margin="0,0,8,0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                         Background="#45475A" Foreground="#CDD6F4"
                         BorderBrush="#585B7A" BorderThickness="1"
                         Padding="8,5" FontSize="13"
                         VerticalContentAlignment="Center"/>

                <TextBlock Grid.Column="2" Text="Puerto:"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="#CDD6F4" Margin="12,0,8,0"/>

                <TextBox Grid.Column="3"
                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                         Background="#45475A" Foreground="#CDD6F4"
                         BorderBrush="#585B7A" BorderThickness="1"
                         Padding="8,5" FontSize="13"
                         VerticalContentAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Bypass List -->
        <Border Grid.Row="5" Background="#313244" CornerRadius="8" Padding="16,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Bypass (exceptos):"
                           FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,6"/>

                <TextBox Grid.Row="1"
                         Text="{Binding BypassList, UpdateSourceTrigger=PropertyChanged}"
                         Background="#45475A" Foreground="#CDD6F4"
                         BorderBrush="#585B7A" BorderThickness="1"
                         Padding="8,6" FontSize="12"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         MinHeight="36"
                         VerticalContentAlignment="Top"
                         ToolTip="Separar con punto y coma (;)&#10;Ej: 192.168.52.*;*.minag.gob.cu"/>
            </Grid>
        </Border>

        <!-- Info Panel -->
        <Border x:Name="InfoBorder" Grid.Row="6" Background="#181825" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Border.RenderTransform>
                <ScaleTransform x:Name="InfoScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="🖥️ " FontSize="12" Foreground="#89B4FA"/>
                    <TextBlock FontSize="12" Foreground="#A6ADC8">
                        <Run Text="Sistema: " FontWeight="SemiBold"/>
                        <Run Text="{Binding SystemStatusText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔧 " FontSize="12" Foreground="#89B4FA"/>
                    <TextBlock FontSize="12" Foreground="#A6ADC8">
                        <Run Text="Git: " FontWeight="SemiBold"/>
                        <Run Text="{Binding GitStatusText, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <Grid Grid.Row="7" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0"
                    Command="{Binding ApplyCommand}"
                    IsEnabled="{Binding IsApplying, Converter={x:Static local:InvertBoolConverter.Instance}}"
                    Background="#89B4FA" Foreground="#1E1E2E"
                    FontWeight="Bold" FontSize="13"
                    Padding="0,8" Cursor="Hand">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="ApplyText" Text="Aplicar" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ApplyLoading" Text=" ⏳" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding IsApplying, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Button.Content>
            </Button>

            <Button Grid.Column="2"
                    Command="{Binding ResetCommand}"
                    IsEnabled="{Binding IsResetting, Converter={x:Static local:InvertBoolConverter.Instance}}"
                    Background="#45475A" Foreground="#CDD6F4"
                    FontSize="13"
                    Padding="0,8" Cursor="Hand">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="ResetText" Text="Restablecer" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ResetLoading" Text=" ⏳" FontSize="11" VerticalAlignment="Center"
                                   Visibility="{Binding IsResetting, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>
                </Button.Content>
            </Button>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="8" Background="#181825" CornerRadius="6" Padding="12,8"
                VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" Fill="{Binding StatusColor}" Margin="0,0,8,0"/>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12" Foreground="#A6ADC8"/>
            </StackPanel>
        </Border>
        </Grid>

        <!-- Toast Notification (overlay outside layout) -->
        <Border x:Name="ToastBorder"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                CornerRadius="8" Padding="20,10" Margin="0,0,0,50"
                Visibility="{Binding ToastVisible, Converter={StaticResource BoolToVisibility}}"
                RenderTransformOrigin="0.5,0.5"
                Panel.ZIndex="100" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastTranslate" Y="20"/>
            </Border.RenderTransform>
            <Border.Background>
                <SolidColorBrush Color="{Binding ToastColor}"/>
            </Border.Background>
            <TextBlock Text="{Binding ToastMessage}"
                       Foreground="White" FontSize="13" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</mahApps:MetroWindow>