<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GitProxyManager"
        xmlns:vm="clr-namespace:GitProxyManager.ViewModels"
        x:Class="GitProxyManager.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Git Proxy Manager"
        Height="660" Width="480"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E"
        Foreground="#CDD6F4">

    <Window.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <local:BoolToBrushConverter x:Key="BoolToBrushConverter"/>
        <local:BoolToHorizontalAlignmentConverter x:Key="BoolToHorizontalAlignmentConverter"/>
        <local:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <local:StringToBrushConverter x:Key="StringToBrushConverter"/>
    </Window.Resources>

    <Grid>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <TextBlock Grid.Row="0" Text="Git Proxy Manager"
                       FontSize="22" FontWeight="Bold"
                       Foreground="#89B4FA" Margin="0,0,0,16"/>

            <!-- Master Toggle -->
            <Border x:Name="MasterBorder" Grid.Row="1" Background="#45475A" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔗"
                               FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>

                    <TextBlock Grid.Column="1" Text="Habilitar ambos"
                               VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold"
                               Foreground="#CDD6F4"/>

                    <ToggleButton x:Name="MasterToggleProxy" Grid.Column="2"
                                  IsChecked="{Binding MasterToggle}"
                                  MinWidth="60" MinHeight="30"
                                  VerticalAlignment="Center">
                        <ToggleButton.Template>
                            <ControlTemplate>
                                <Border CornerRadius="15" Padding="3"
                                        Background="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToBrushConverter}}">
                                    <Border Width="24" Height="24"
                                            CornerRadius="12"
                                            Background="#CDD6F4"
                                            Margin="2"
                                            HorizontalAlignment="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToHorizontalAlignmentConverter}}"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                </Grid>
            </Border>

            <!-- System Proxy Toggle -->
            <Border x:Name="SystemBorder" Grid.Row="2" Background="#313244" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🖥️"
                               FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Proxy del sistema"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                        <TextBlock Text="Sistema (navegadores, etc.)"
                                   FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ToggleButton x:Name="SystemToggleProxy" Grid.Column="2"
                                  IsChecked="{Binding IsSystemEnabled}"
                                  IsEnabled="{Binding CanToggle}"
                                  Margin="12,0"
                                  MinWidth="46" MinHeight="24"
                                  VerticalAlignment="Center">
                        <ToggleButton.Template>
                            <ControlTemplate>
                                <Border CornerRadius="12" Padding="3"
                                        Background="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToBrushConverter}}">
                                    <Border Width="18" Height="18"
                                            CornerRadius="9"
                                            Background="#CDD6F4"
                                            Margin="2"
                                            HorizontalAlignment="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToHorizontalAlignmentConverter}}"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Ellipse Grid.Column="3" Width="8" Height="8"
                             VerticalAlignment="Center" Margin="10,0,0,0"
                             Fill="{Binding SystemStatusColor, Converter={StaticResource StringToBrushConverter}}"/>
                </Grid>
            </Border>

            <!-- Git Proxy Toggle -->
            <Border x:Name="GitBorder" Grid.Row="3" Background="#313244" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="🔧"
                               FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Proxy de Git"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#CDD6F4"/>
                        <TextBlock Text="Solo operaciones git"
                                   FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,0"/>
                    </StackPanel>

                    <ToggleButton x:Name="GitToggleProxy" Grid.Column="2"
                                  IsChecked="{Binding IsGitEnabled}"
                                  IsEnabled="{Binding CanToggle}"
                                  Margin="12,0"
                                  MinWidth="46" MinHeight="24"
                                  VerticalAlignment="Center">
                        <ToggleButton.Template>
                            <ControlTemplate>
                                <Border CornerRadius="12" Padding="3"
                                        Background="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToBrushConverter}}">
                                    <Border Width="18" Height="18"
                                            CornerRadius="9"
                                            Background="#CDD6F4"
                                            Margin="2"
                                            HorizontalAlignment="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToHorizontalAlignmentConverter}}"/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>

                    <Ellipse Grid.Column="3" Width="8" Height="8"
                             VerticalAlignment="Center" Margin="10,0,0,0"
                             Fill="{Binding GitStatusColor, Converter={StaticResource StringToBrushConverter}}"/>
                </Grid>
            </Border>

            <!-- Proxy Host + Port -->
            <Border Grid.Row="4" Background="#313244" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Proxy:"
                               VerticalAlignment="Center" FontSize="13"
                               Foreground="#CDD6F4" Margin="0,0,8,0"/>

                    <TextBox Grid.Column="1"
                             Text="{Binding Host}"
                             Background="#45475A" Foreground="#CDD6F4"
                             BorderBrush="#585B7A" BorderThickness="1"
                             Padding="8,5" FontSize="13"
                             VerticalContentAlignment="Center"/>

                    <TextBlock Grid.Column="2" Text="Puerto:"
                               VerticalAlignment="Center" FontSize="13"
                               Foreground="#CDD6F4" Margin="12,0,8,0"/>

                    <TextBox Grid.Column="3"
                             Text="{Binding Port}"
                             Background="#45475A" Foreground="#CDD6F4"
                             BorderBrush="#585B7A" BorderThickness="1"
                             Padding="8,5" FontSize="13"
                             VerticalContentAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Bypass List -->
            <Border Grid.Row="5" Background="#313244" CornerRadius="8" Padding="16,10" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Bypass (exceptos):"
                               FontSize="12" Foreground="#A6ADC8" Margin="0,0,0,6"/>

                    <TextBox Grid.Row="1"
                             Text="{Binding BypassList}"
                             Background="#45475A" Foreground="#CDD6F4"
                             BorderBrush="#585B7A" BorderThickness="1"
                             Padding="8,6" FontSize="12"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             MinHeight="36"
                             VerticalContentAlignment="Top"
                             ToolTip.Tip="Separar con punto y coma (;)&#10;Ej: 192.168.52.*;*.minag.gob.cu"/>
                </Grid>
            </Border>

            <!-- Info Panel -->
            <Border x:Name="InfoBorder" Grid.Row="6" Background="#181825" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="🖥️ " FontSize="12" Foreground="#89B4FA"/>
                        <TextBlock FontSize="12" Foreground="#A6ADC8">
                            <Run Text="Sistema: " FontWeight="SemiBold"/>
                            <Run Text="{Binding SystemStatusText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔧 " FontSize="12" Foreground="#89B4FA"/>
                        <TextBlock FontSize="12" Foreground="#A6ADC8">
                            <Run Text="Git: " FontWeight="SemiBold"/>
                            <Run Text="{Binding GitStatusText, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Buttons -->
            <Grid Grid.Row="7" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Command="{Binding ApplyCommand}"
                        IsEnabled="{Binding IsApplying, Converter={x:Static local:InvertBoolConverter.Instance}}"
                        Background="#89B4FA" Foreground="#1E1E2E"
                        FontWeight="Bold" FontSize="13"
                        Padding="0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="ApplyText" Text="Aplicar" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ApplyLoading" Text=" ⏳" FontSize="11" VerticalAlignment="Center"
                                   IsVisible="{Binding IsApplying}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="2"
                        Command="{Binding ResetCommand}"
                        IsEnabled="{Binding IsResetting, Converter={x:Static local:InvertBoolConverter.Instance}}"
                        Background="#45475A" Foreground="#CDD6F4"
                        FontSize="13"
                        Padding="0,8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="ResetText" Text="Restablecer" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ResetLoading" Text=" ⏳" FontSize="11" VerticalAlignment="Center"
                                   IsVisible="{Binding IsResetting}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="8" Background="#181825" CornerRadius="6" Padding="12,8"
                    VerticalAlignment="Bottom">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8"
                             Fill="{Binding StatusColor, Converter={StaticResource StringToBrushConverter}}"
                             Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="12" Foreground="#A6ADC8"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toast Notification (overlay outside layout) -->
        <Border x:Name="ToastBorder"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                CornerRadius="8" Padding="20,10" Margin="0,0,0,50"
                IsVisible="{Binding ToastVisible, Converter={StaticResource BoolToVisibility}}"
                RenderTransformOrigin="0.5,0.5"
                ZIndex="100" IsHitTestVisible="False">
            <Border.RenderTransform>
                <TranslateTransform Y="20"/>
            </Border.RenderTransform>
            <Border.Background>
                <SolidColorBrush Color="{Binding ToastColor, Converter={x:Static local:StringToColorConverter.Instance}}"/>
            </Border.Background>
            <TextBlock Text="{Binding ToastMessage}"
                       Foreground="White" FontSize="13" FontWeight="SemiBold"/>
        </Border>
    </Grid>
</Window>
